# Salin berkas ini menjadi `.env` lalu sesuaikan nilainya.
# JANGAN commit berkas `.env` yang berisi kredensial asli.

# ---------------------------------------------------------------------------
# Aplikasi
# ---------------------------------------------------------------------------
APP_NAME="WiFiCare CDN"
APP_ENV=local
# Jangan aktifkan di production. Detail error tetap dicatat di storage/logs/app.log.
APP_DEBUG=false
APP_URL=http://localhost:8000
# Zona waktu aplikasi. Harus sama dengan zona waktu MySQL agar batas harian
# (AI/OTP/WhatsApp) dan laporan konsisten.
APP_TIMEZONE=Asia/Jakarta
# Base path bila aplikasi dipasang pada subfolder (mis. /wificare-cdn/public).
APP_BASE_PATH=

# ---------------------------------------------------------------------------
# Database MySQL
# XAMPP/Laragon bawaan: user `root` tanpa password.
# ---------------------------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=wificare_cdn_v1
DB_USER=root
DB_PASSWORD=
# Akun dB READ-ONLY opsional KHUSUS pembacaan oleh AI Assistant (SELECT saja).
# Kosongkan untuk memakai akun utama. Disarankan di produksi (lihat README).
DB_RO_USER=
DB_RO_PASSWORD=

# ---------------------------------------------------------------------------
# Session
# ---------------------------------------------------------------------------
SESSION_NAME=wificare_session
SESSION_LIFETIME=7200
# Lax (default) aman untuk aplikasi tanpa embed lintas situs.
SESSION_SAMESITE=Lax
# Rotasi ID sesi berkala (detik) selama pengguna aktif.
SESSION_REGENERATE_EVERY=1800
# Biarkan false pada HTTP lokal; Session otomatis memaksa Secure saat HTTPS.
SESSION_COOKIE_SECURE=false

# ---------------------------------------------------------------------------
# Keamanan login
# ---------------------------------------------------------------------------
LOGIN_MAX_ATTEMPTS=5
LOGIN_ATTEMPT_WINDOW=15
LOGIN_MAX_IP_ATTEMPTS=10

# ---------------------------------------------------------------------------
# AI Assistant (WiFiCare AI) — ISI NILAI DI BERKAS .env, JANGAN DI .env.example
# Kunci hanya dibaca di sisi server. Butuh koneksi internet untuk API eksternal.
# WiFiCare AI bersifat OPERASIONAL + READ-ONLY: tidak melayani permintaan coding
# dan tidak pernah menulis/mengubah data; data tiket dibaca lewat fungsi PHP
# terkontrol (SELECT) sesuai peran pengguna. Lihat README bagian "WiFiCare AI".
# ---------------------------------------------------------------------------
# Provider aktif: "gemini", "deepseek", atau "openai". Bila kosong, dipilih
# otomatis (Gemini bila GEMINI_API_KEY terisi; selain itu OpenAI-compatible).
# Admin dapat mengganti provider lewat dashboard; nilai ini hanya fallback.
AI_PROVIDER=gemini

# --- Google Gemini (generateContent) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# Model cadangan (dipisah koma) bila model utama 503/429/404. Kosong = tanpa cadangan.
GEMINI_MODEL_FALLBACK=gemini-3.8-flash,gemini-flash-latest
GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# 0 = nonaktifkan proses berpikir (respons lebih cepat); kosong = bawaan model.
GEMINI_THINKING_BUDGET=0

# --- DeepSeek (chat/completions, kompatibel OpenAI) ---
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_API_BASE_URL=https://api.deepseek.com/v1

# --- OpenAI (opsional) ---
AI_API_KEY=
AI_MODEL=
AI_API_BASE_URL=https://api.openai.com/v1

# --- Umum ---
AI_TIMEOUT=25
# Percobaan ulang per model untuk error sementara (429/5xx).
AI_MAX_RETRIES=1
AI_MAX_MESSAGE=2000
AI_RATE_LIMIT=20
AI_RATE_WINDOW=60
AI_MAX_TOOL_ROUNDS=3

# ---------------------------------------------------------------------------
# Pengaturan AI Chatbot (Tahap 11) — enkripsi API key yang disimpan via dashboard
# ---------------------------------------------------------------------------
# Master key enkripsi API key (32 byte, base64) HANYA dibaca dari environment ini.
# WAJIB diisi agar Admin dapat menyimpan API key lewat dashboard. Bila kosong,
# halaman Pengaturan AI menampilkan informasi aman dan API key TIDAK disimpan.
# Buat kunci baru: `php bin/ai-keygen.php`. JANGAN commit kunci asli.
AI_SETTINGS_KEY=

# ---------------------------------------------------------------------------
# Pusat API & WhatsApp Gateway (Tahap 17)
# ---------------------------------------------------------------------------
# Alias master key. Bila kosong, API_CREDENTIALS_KEY memakai AI_SETTINGS_KEY
# sehingga kredensial lama tetap dapat didekripsi. JANGAN simpan kunci di DB.
API_CREDENTIALS_KEY=
API_DEFAULT_COUNTRY_CODE=62
API_HTTP_TIMEOUT=20
WHATSAPP_API_VERSION=v20.0
WHATSAPP_API_BASE=https://graph.facebook.com
# Fonnte memakai endpoint resmi ini; token diisi lewat Admin, bukan .env.
FONNTE_API_BASE=https://api.fonnte.com

# ---------------------------------------------------------------------------
# Rating Layanan
# ---------------------------------------------------------------------------
# Dinonaktifkan sementara secara default. Data rating lama tetap tersimpan.
# Set 1 untuk menampilkan kembali menu/form/endpoint rating tanpa migrasi.
RATING_LAYANAN_ENABLED=0
