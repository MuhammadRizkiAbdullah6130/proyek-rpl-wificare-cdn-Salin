{
    "name": "wificare/cdn",
    "description": "Sistem manajemen pengaduan pelanggan WiFi — PHP Native 8.2+, MySQL, tanpa framework.",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "serve": "php -S localhost:8000 -t public",
        "test": "@php vendor/phpunit/phpunit/phpunit",
        "test:unit": "@php vendor/phpunit/phpunit/phpunit --testsuite Unit",
        "test:integration": "@php vendor/phpunit/phpunit/phpunit --testsuite Integration"
    },
    "config": {
        "sort-packages": true,
        "platform": {
            "php": "8.2.0"
        }
    }
}
